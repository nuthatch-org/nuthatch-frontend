    ground(); build();
    items.sort((a, b) => b.d - a.d);
    for (const it of items) it.k ? drawQuad(it) : drawBox(it);
    for (const f of overlay) f();
    const px = clamp(cssW / 88, 10.5, 13) * dpr;
    ctx.textBaseline = 'alphabetic'; ctx.lineJoin = 'round';
