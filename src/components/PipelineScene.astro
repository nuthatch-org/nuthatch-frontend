        else if (back > 0 && back < 1) { const s = 1 - back; seg(s, Math.min(1, s + .22), P.buff, .95, 1.8); const h = pt(s); glow(h[0], h[1], h[2], .55, P.buff, .8); }
        if (q.t > .6 && q.t < 1.7) glow(tp[0], tp[1], tp[2], 1.1, P.ink, .35 * (1 - Math.abs(q.t - 1.15) / .55));
      });
    });
    S.sparks.forEach(s => overlay.push(() => glow(s.p[0], s.p[1], s.p[2], .5 + s.t * 1.1, s.rust ? P.rust : P.ink, (1 - s.t) * .8)));

    // labels
    if (v === 0) {
      if (wide) {
        lab(-13.6, 2.15, 0, 'chain RPC'); lab(GATE_X, 2.85, 0, 'decode · topic0'); lab(-4, 3.75, BAR_Z, 'incremental views');
        lab(HOT_X, hotTop + 1.25, 0, 'redb · live tip', { c: 'buff' }); lab(PLANE_X, 4.3, -3, pr ? 'reorgs stop here' : 'finality', { c: pr ? 'rust' : 'muted' });
        lab(7.65, segTop + 1.7, -1.7, 'Parquet · sealed', { c: 'slate' }); lab(LENS[0], 4.55, 0, 'burrmill'); lab(EP[0] + .3, 3.1, 0, 'localhost:8288', { al: 'left' });
      } else {
        [[-13.6, 2.1, 0], [GATE_X, 2.9, 0], [-4, 3.6, BAR_Z], [3.2, 4.3, 0], [12.5, 3.9, 0]].forEach((p, i) => lab(p[0], p[1], p[2], String(i + 1), { big: true }));
