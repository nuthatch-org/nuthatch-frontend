    if (v === 5) { lab(LENS[0], 3.75, 0, 'burrmill'); lab(EP[0], 2.95, 0, 'localhost:8288'); lab(7.65, segTop + 1.7, -1.7, 'Parquet · sealed', { c: 'slate' }); }
