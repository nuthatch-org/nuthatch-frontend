      box(ch.p[0], ch.p[1], ch.p[2], .34, .12, .34, col, { a: ch.kill ? Math.max(0, ch.fade) : 1, glow: ch.kill ? 0 : .3 + k * .3 });
    });
    S.retr.forEach(r => { if (r.p) box(r.p[0], r.p[1], r.p[2], .34, .12, .34, P.rust, { glow: .9 }); });
    // 3 entities
    for (let l = 0; l < 3; l++) {
      const h = .25 + S.barShow[l] * .2, fl = S.barFlash[l];
      box(OPX[l], h / 2 + .01, BAR_Z, .8, h, .8, fl < -.05 ? mix(P.lane[l], P.rust, Math.min(1, -fl * 1.4)) : P.lane[l], { glow: Math.abs(fl) * .9, gcol: fl < 0 ? P.rust : P.ink });
      if (v === 3) { lab(OPX[l], h + .35, BAR_Z, BARS[l], { c: 'ink' }); lab(-6.6, .5, LANE_Z[l], LANES[l], { c: 'muted', al: 'right' }); }
      if (v === 2) lab(-5.9, .75, LANE_Z[l], LANES[l], { c: 'ink' });
    }
