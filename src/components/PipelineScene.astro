  }
  function initSim() {
    for (let i = 0; i < 9; i++) { const p = slotPos(i); S.segs.push({ id: segId(), y: p[1], glow: 0, born: -9 }); }
    const tip = S.tip;
    for (let n = tip - 5; n <= tip; n++) newBlock(n, false, true);
    S.hot.shift();                       // the oldest visible block is already sealed
    for (let i = 0; i < 300; i++) step(1 / 30);
