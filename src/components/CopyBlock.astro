---
// A copyable command block. With JS: click to copy, label flips to "copied"
// for 1.5s. Without JS: the command is plain, selectable, styled text.
interface Props {
  command: string;
  prompt?: boolean; // render a leading `$` that is NOT part of the copied text
  size?: 'lg' | 'md';
  label?: string;
}
const { command, prompt = true, size = 'md', label = 'Copy command' } = Astro.props;
---
<div class={`copyblock copyblock--${size}`}>
  <code class="copyblock-code">
    {prompt && <span class="copyblock-prompt" aria-hidden="true">$</span>}
    <span class="copyblock-text">{command}</span>
  </code>
  <button class="copyblock-btn" type="button" data-copy={command} aria-label={label}>
    <span class="copyblock-btn-label">copy</span>
  </button>
</div>

<style>
  /* Foundry's install line: the command in mono on bg-code, the prompt in brick, "copy" after a hairline. */
  .copyblock {
    display: flex; align-items: center; gap: 10px;
    background: var(--bg-code);
    border: 1px solid var(--border-hi);
    border-radius: var(--radius-sm);
    padding: 6px 6px 6px 14px;
    transition: border-color 160ms;
  }
  .copyblock:hover { border-color: var(--accent); }
  .copyblock-code {
    flex: 1; min-width: 0;
    display: flex; align-items: baseline; gap: 0.6rem;
    overflow-x: auto; white-space: nowrap;
    font-size: 0.75rem; line-height: 1.85; color: var(--text);
    scrollbar-width: thin;
  }
  :not(pre) > .copyblock-code { padding: 0; background: none; border-radius: 0; overflow-wrap: normal; }
  .copyblock--lg { padding: 8px 8px 8px 16px; }
  .copyblock--lg .copyblock-code { font-size: clamp(0.6875rem, 2.1vw, 0.8125rem); }
  .copyblock-prompt { color: var(--accent); user-select: none; }
  .copyblock-text { color: var(--text); }
  .copyblock-btn {
    flex-shrink: 0;
    font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.02em;
    color: var(--text-muted);
    background: none; border: 0; border-left: 1px solid var(--border);
    padding: 0.35rem 0.5rem 0.35rem 10px; cursor: pointer;
    transition: color 160ms;
  }
  .copyblock-btn:hover { color: var(--accent); }
  .copyblock-btn.is-copied { color: var(--ok); }
</style>
