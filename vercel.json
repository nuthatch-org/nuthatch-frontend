{
  "headers": [
    {
      "source": "/(docs|blog)/(.*)\\.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/(docs|changelog).md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ],
  "redirects": [
    {
      "source": "/play",
      "destination": "/play/",
      "permanent": true
    },
    {
      "source": "/play/build",
