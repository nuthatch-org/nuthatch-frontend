    if (C[0] > b.x + hx) face(Object.assign([1, 3, 7, 5], { sx: 1 }), .36, 'x'); else if (C[0] < b.x - hx) face(Object.assign([0, 4, 6, 2], { sx: -1 }), .22, 'x');
    if (C[2] > b.z + hz) face(Object.assign([4, 5, 7, 6], { sz: 1 }), .12, 'z'); else if (C[2] < b.z - hz) face(Object.assign([0, 2, 3, 1], { sz: -1 }), .44, 'z');
