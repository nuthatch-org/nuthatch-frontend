---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Palette from '../components/Palette.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  /** Dim machine parts drifting in the margins: marketing pages only, never pages for reading. */
  ambient?: boolean;
}
const {
  title = 'Nuthatch - be your own indexer',
  description = "Turn an EVM contract's history into a local SQL database. One Rust binary, no Postgres, no subgraph to write, and an MCP server built in.",
  path = '/',
  ambient = false,
} = Astro.props;
const site = Astro.site ?? 'https://nuthatch-indexer.com';
const canonical = new URL(path, site).href;
const ogImage = new URL('/og.png', site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#171614" />

    <!-- Open Graph. The card image is self-hosted on our own domain - still
         no CDN, no third party, nothing phoning home. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Nuthatch" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Nuthatch - be your own indexer. Self-hosted blockchain indexer in one Rust binary." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Self-hosted fonts, preloaded. No CDN, no Google Fonts, no phone-home. -->
    <link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    <!-- Theme persistence: the one thing a pure-CSS toggle can't do across page loads. Reads a local
         preference and applies it before paint (no flash). No network, no third party - just a
         localStorage read/write. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          if (localStorage.getItem('theme') === 'light') root.setAttribute('data-theme', 'light');
        } catch (e) {}
        document.addEventListener('DOMContentLoaded', function () {
          var cb = document.getElementById('theme-toggle');
          if (!cb) return;
          cb.checked = root.getAttribute('data-theme') === 'light';
          cb.addEventListener('change', function () {
            var light = cb.checked;
            root.setAttribute('data-theme', light ? 'light' : 'dark');
            try { localStorage.setItem('theme', light ? 'light' : 'dark'); } catch (e) {}
          });
        });
      })();
    </script>
  </head>
  <body class={ambient ? 'has-ambient' : undefined}>
    {ambient && <canvas id="ambient" aria-hidden="true"></canvas>}
    <a href="#main" class="skip">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Palette />

    <!-- The scenery: three.js scenes, self-hosted, imported only after first paint. Without WebGL,
         or if the import fails, the page is simply the dark ground it already is. -->
    <script>
      const hero = document.querySelector<HTMLCanvasElement>('canvas[data-scene="machine-room"]');
      const ambient = document.querySelector<HTMLCanvasElement>('#ambient');
      const webgl = () => {
        try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); }
        catch { return false; }
      };
      if ((hero || ambient) && webgl()) {
        const start = async () => {
          try {
            const url = '/foundry/scenes.js';
            const m = await import(/* @vite-ignore */ url);
            if (hero) m.createMachineRoom(hero);
            if (ambient) m.createAmbient(ambient, { kit: 'machine', contentWidth: 1296 });
          } catch { /* the page stands without it */ }
        };
        const idle = (window as any).requestIdleCallback ?? ((fn: () => void) => setTimeout(fn, 200));
        if (document.readyState === 'complete') idle(start, { timeout: 2000 });
        else addEventListener('load', () => idle(start, { timeout: 2000 }), { once: true });
      }
    </script>

    <!-- Shared copy-to-clipboard handler for every [data-copy] control.
         The only site-wide JS besides the terminal typewriter. Degrades to
         plain selectable text when disabled. -->
    <script>
      const supported = typeof navigator !== 'undefined' && !!navigator.clipboard;
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
        const label = btn.querySelector('.copyblock-btn-label');
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy') ?? '';
          try {
            if (supported) {
              await navigator.clipboard.writeText(text);
            } else {
              const ta = document.createElement('textarea');
              ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
              document.body.appendChild(ta); ta.select();
              document.execCommand('copy'); ta.remove();
            }
            if (label) label.textContent = 'copied';
            btn.classList.add('is-copied');
            setTimeout(() => {
              if (label) label.textContent = 'copy';
              btn.classList.remove('is-copied');
            }, 1500);
          } catch {
            if (label) label.textContent = 'press ⌘C';
          }
        });
      });
    </script>
  </body>
</html>
