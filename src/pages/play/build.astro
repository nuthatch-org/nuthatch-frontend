---
import Layout from '../../layouts/Layout.astro';
// The page is the site's; build.js, its worker and the wasm module come from the nuthatch-play project,
// which vercel.json proxies under /play/.
---
<Layout
  path="/play/build/"
  title="Nest builder - Nuthatch"
  description="Paste a contract address and your browser scaffolds the nest nuthatch init would, indexes it from its deploy block and answers SQL over it, with nuthatch's own code compiled to WebAssembly."
>
  <section class="page builder">
    <div class="wrap pg-narrow">
      <p class="section-label">Play</p>
      <h1>Build a nest in your tab</h1>
      <p class="lede">Paste a contract address and this tab scaffolds the nest <code>nuthatch init</code> would, with init's own code compiled to WebAssembly: the same ABI, the same tables, the same identity. Edit its views, press <strong>Index it</strong> to backfill and query it here, or download it and run it with <code>nuthatch dev</code>. Nothing is sent anywhere but the RPCs and Sourcify. To query a nest someone has already published, <a href="/play/">open the playground</a>.</p>
    <div class="row">
      <label class="faint" for="chain">Chain</label>
      <select id="chain"></select>
    </div>
    <div class="row">
      <input id="address" placeholder="0x… a contract verified on Sourcify" spellcheck="false" autocomplete="off">
      <input id="alias" placeholder="alias (optional)" spellcheck="false">
      <input id="start" placeholder="start block (optional)" inputmode="numeric">
      <button id="add" class="go">Add contract</button>
    </div>
    <div class="row">
      <label class="faint" for="rpc">RPC</label>
      <input id="rpc" value="https://rpc.mevblocker.io" spellcheck="false">
    </div>
    <div id="status">Loading nuthatch…</div>
  
    <div id="out" hidden>
      <h2>Contracts</h2>
      <div id="contracts"></div>
  
      <h2>Identity</h2>
      <div class="card">
        <div class="row"><label class="faint" for="name">Nest name</label><input id="name" spellcheck="false"></div>
        <div id="identity" class="mono"></div>
        <p class="faint" style="margin:8px 0 0">The NID is the key a node stores this nest's data under. Editing a view moves it; the data identity, which says what gets indexed, stays put.</p>
      </div>
  
      <h2>Tables</h2>
      <div id="tables" class="mono"></div>
  
      <h2>Views</h2>
      <div class="row">
        <select id="view"></select>
        <button id="new-view" class="quiet">New view</button>
      </div>
      <textarea id="sql" spellcheck="false"></textarea>
      <div id="view-check" class="faint mono"></div>
  
      <h2>Index it</h2>
      <p class="faint" style="margin:0 0 8px">This tab backfills the nest from its first block and seals it with nuthatch's own sealer, then keeps the newest blocks on top. A block is sealed only when two RPCs both call it finalized, give it one hash and return the same logs for it. That is agreement, not proof: the light client the playground uses checks headers near the head, and over a backfill it would cost more than the backfill. A young contract takes seconds to a minute. Both default RPCs served logs 60,000 blocks back (about eight days) when this page was built; publicnode keeps about 20,000 and flashbots answers older ranges with nothing, so neither is a default. An older contract needs an RPC with full history in either box.</p>
      <div class="row">
        <label class="faint" for="second">Second RPC</label>
        <input id="second" value="https://eth.drpc.org" spellcheck="false">
        <button id="index" class="go">Index it</button>
      </div>
      <div id="progress" class="faint mono"></div>
      <div id="sealed" class="faint mono"></div>
      <div id="query-box" hidden>
        <textarea id="q" spellcheck="false" style="min-height:96px"></textarea>
        <div class="row"><button id="query" class="go">Run</button><span id="qstatus" class="faint"></span></div>
        <div class="wrap-table"><table id="result"></table></div>
      </div>
  
      <h2>Keep it</h2>
      <div class="row">
        <button id="download" class="go">Download the nest</button>
        <span id="run" class="faint mono"></span>
      </div>
    </div>
    </div>
  </section>
  <script is:inline type="module" src="/play/build.js"></script>
</Layout>

<style is:global>
  /* Global under .builder because build.js makes most of the page's elements. */
  .builder {
    --panel: var(--bg-elev); --ink: var(--text); --faint: var(--text-muted); --line: var(--border-hi);
    --code: var(--bg-inset); --err: #f08a7e; --accent: #c8693a; --accent-ink: #fff;
  }
  :root[data-theme='light'] .builder { --err: #a3271b; --accent: #a8481f; }
  .builder.page { padding-block: 2rem 4rem; }
  .builder .pg-narrow { max-width: 62rem; }
  .builder h1 { margin: 0.2rem 0 0.4rem; }
  .builder h2 { font-size: 1rem; margin: 20px 0 8px; }
  .builder .lede { color: var(--faint); margin: 0 0 20px; max-width: 72ch; }
  .builder .lede a { color: var(--accent); }
  .builder code { background: var(--code); padding: 1px 4px; border-radius: 4px; font-size: 0.85em; }
  .builder input, .builder button, .builder textarea, .builder select { font: inherit; color: inherit; }
  .builder input, .builder select { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 6px 8px; min-width: 0; }
  .builder .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 8px; }
  .builder #address { flex: 1 1 26rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .builder #alias, .builder #start { flex: 0 1 11rem; }
  .builder #rpc, .builder #second { flex: 1 1 18rem; }
  .builder #name { flex: 0 1 14rem; }
  .builder .go { background: var(--accent); color: var(--accent-ink); border: 0; border-radius: 6px; padding: 7px 16px; font-weight: 600; cursor: pointer; }
  .builder .go:disabled { opacity: 0.5; cursor: progress; }
  .builder .quiet { background: none; border: 1px solid var(--line); border-radius: 6px; padding: 6px 10px; cursor: pointer; color: var(--faint); }
  .builder #status { font-size: 0.85rem; color: var(--faint); min-height: 1.5em; }
  .builder #status.err { color: var(--err); }
  .builder #view-check.err { color: var(--err); white-space: pre-wrap; }
  .builder .card { border: 1px solid var(--line); border-radius: 8px; background: var(--panel); padding: 10px 12px; margin-bottom: 8px; }
  .builder .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.82rem; overflow-wrap: anywhere; }
  .builder .faint { color: var(--faint); }
  .builder #contracts .card { display: flex; gap: 8px; align-items: baseline; justify-content: space-between; }
  .builder #identity { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 2px 12px; }
  .builder #tables { display: flex; flex-wrap: wrap; gap: 6px; }
  .builder .pill { background: var(--code); border-radius: 999px; padding: 2px 10px; }
  .builder textarea { width: 100%; min-height: 220px; resize: vertical; background: var(--panel); border: 1px solid var(--line); border-radius: 8px; padding: 10px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.85rem; }
  .builder #out[hidden], .builder #query-box[hidden] { display: none; }
  .builder .wrap-table { overflow: auto; max-height: 50vh; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); }
  .builder table { border-collapse: collapse; font-size: 0.82rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .builder th, .builder td { padding: 4px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; text-align: left; }
  .builder th { position: sticky; top: 0; background: var(--code); font-weight: 600; }
</style>
