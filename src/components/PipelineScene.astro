    if (v === 2) { lab(-9.9, 1.75, 0, 'raw logs', { c: 'muted' }); lab(GATE_X, 2.85, 0, 'decode · topic0'); }
    if (v === 3) lab(-4, .25 + 14 * .2 + .9, BAR_Z, 'entities, kept current', { c: 'muted' });
