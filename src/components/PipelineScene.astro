  }

  // ---------- readouts
  const ro = { tip: '', hot: '', cold: '', st: '' };
  function readouts() {
    const set = (k, id, v) => { if (ro[k] !== v) { ro[k] = v; $(id).textContent = v; } };
    set('tip', 'ps-tip', '#' + fmt(S.tip));
    set('hot', 'ps-hot', S.hot.filter(s => !s.retract).length + ' blocks');
    set('cold', 'ps-cold', S.sealed + ' segments');
    const q = S.query;
    const [kind, text] = S.reorgMsg > 0 ? ['reorg', 'reorg, depth 2: two blocks retracted, sealed segments untouched']
      : S.seals.length ? ['seal', 'sealing 3 blocks past finality into one Parquet segment']
      : q && q.t > 1.6 ? ['query', q.label + ' → ' + q.rows + ' rows, read from redb and ' + (q.targets.length - 1) + ' segments']
      : ['', 'following the tip'];
    if (ro.st !== text) { ro.st = text; const el = $('ps-status'); el.textContent = text; el.dataset.kind = kind; }
    $('ps-reorg').disabled = S.reorgCool > 0;
  }

  // ---------- loop + input
  let playing = !reduce, inView = true, last = 0, dirty = true;
  function resize() {
    const r = cv.getBoundingClientRect();
    if (!r.width) return;
    dpr = Math.min(2, window.devicePixelRatio || 1); cssW = r.width;
    W = cv.width = Math.round(r.width * dpr); H = cv.height = Math.round(r.height * dpr);
    focal = H / 2 / Math.tan(15 * Math.PI / 180);
    const uy = userYaw, up = userPitch; setView(view, true); userYaw = uy; userPitch = up; dirty = true;
  }
  function frame(now) {
    requestAnimationFrame(frame);
    const dt = Math.min(.05, (now - last) / 1000 || 0); last = now;
    if (!inView || document.hidden || !W) return;
    if (playing) step(dt);
    const k = reduce ? 1 : 1 - Math.exp(-dt * 3.2);
    const drift = playing && !dragging ? Math.sin(now / 4200) * .05 : 0;
    const gy = clamp(goal.yaw + userYaw + drift, -1.4, 1.4), gp = clamp(goal.pitch + userPitch, .12, 1.15);
    const moving = Math.abs(gy - cam.yaw) + Math.abs(gp - cam.pitch) + Math.abs(goal.dist - cam.dist) / 40 + Math.abs(goal.tx - cam.tx) / 20 > 1e-4;
    cam.yaw += (gy - cam.yaw) * k; cam.pitch += (gp - cam.pitch) * k; cam.dist += (goal.dist - cam.dist) * k;
    cam.tx += (goal.tx - cam.tx) * k; cam.ty += (goal.ty - cam.ty) * k; cam.tz += (goal.tz - cam.tz) * k;
    if (playing || moving || dirty) { render(); readouts(); dirty = false; }
  }
  let px0 = 0, py0 = 0;
  cv.addEventListener('pointerdown', e => { dragging = true; px0 = e.clientX; py0 = e.clientY; try { cv.setPointerCapture(e.pointerId); } catch (_) {} });
  cv.addEventListener('pointermove', e => {
    if (!dragging) return;
    userYaw = clamp(userYaw - (e.clientX - px0) * .006, -1.4 - goal.yaw, 1.4 - goal.yaw);
    if (e.pointerType === 'mouse') userPitch = clamp(userPitch + (e.clientY - py0) * .004, .12 - goal.pitch, 1.15 - goal.pitch);
    px0 = e.clientX; py0 = e.clientY;
  });
  const end = () => { dragging = false; };
  cv.addEventListener('pointerup', end); cv.addEventListener('pointercancel', end);
  cv.addEventListener('keydown', e => {
    const m = { ArrowLeft: [-.12, 0], ArrowRight: [.12, 0], ArrowUp: [0, .08], ArrowDown: [0, -.08] }[e.key];
    if (!m) return; e.preventDefault();
    userYaw = clamp(userYaw + m[0], -1.4 - goal.yaw, 1.4 - goal.yaw); userPitch = clamp(userPitch + m[1], .12 - goal.pitch, 1.15 - goal.pitch);
  });
  $('ps-rail').addEventListener('click', e => { const b = e.target.closest('button'); if (b) setView(view === +b.dataset.view ? 0 : +b.dataset.view, reduce); });
  $('ps-all').addEventListener('click', () => setView(0, reduce));
  const setPlaying = p => { playing = p; $('ps-play').textContent = p ? 'Pause' : 'Play'; };
  $('ps-play').addEventListener('click', () => setPlaying(!playing));
  $('ps-reorg').addEventListener('click', () => { if (reorg()) { if (!playing) setPlaying(true); if (view !== 0 && view !== 3 && view !== 4) setView(0, reduce); } });

  readPalette();
  new MutationObserver(() => { readPalette(); dirty = true; }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  if ('IntersectionObserver' in window) new IntersectionObserver(es => { inView = es[0].isIntersecting; }).observe(cv);
  new ResizeObserver(resize).observe(cv);
  // Labels are canvas text, so repaint once the webfont has arrived.
  if (document.fonts) document.fonts.ready.then(() => { dirty = true; });
  initSim(); setPlaying(playing); resize();
  requestAnimationFrame(frame);
})();
</script>
