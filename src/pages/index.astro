---
import Layout from '../layouts/Layout.astro';
import CopyBlock from '../components/CopyBlock.astro';
import Terminal from '../components/Terminal.astro';
import PipelineScene from '../components/PipelineScene.astro';
import { crtRows } from '../data/transcript';

const GH = 'https://github.com/nuthatch-org/nuthatch';
const crt = JSON.stringify(crtRows());

// Comparison rows, kept identical to the README's table.
const cols = ['Needs a subgraph', 'Needs handler code', 'Data comes from', 'What you run', 'Query with'];
const rows = [
  { p: 'The Graph', us: false, c: ['yes', 'yes (AssemblyScript)', 'indexers on the network', 'nothing, or graph-node + Postgres + IPFS', 'GraphQL'] },
  { p: 'Ponder',    us: false, c: ['no', 'yes (TypeScript)', 'your RPC endpoint', 'Node.js, plus Postgres in production', 'SQL, GraphQL'] },
  { p: 'Nuthatch',  us: true,  c: ['no', 'no: tables come from the ABI', 'your RPC endpoint', 'one binary', 'SQL, HTTP, MCP'] },
];
---
<Layout path="/">
  <!-- 1. HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
      <p class="hero-eyebrow rise rise-1"><span class="tag">v5.17.0 · MIT OR Apache-2.0</span></p>
      <h1 class="rise rise-1">Be your own indexer.</h1>
      <p class="hero-sub narrow rise rise-2">
        Turn an EVM contract's history into a local SQL database. One Rust binary, no Postgres,
        no subgraph to write, and an MCP server built in.
      </p>

      <div class="hero-cta rise rise-3">
        <CopyBlock command="curl -fsSL https://nuthatch-indexer.com/install.sh | sh" size="lg" />
        <p class="hero-alt">
          or: <a href="/install">build with cargo</a>
          &nbsp;·&nbsp;
          <a href="https://github.com/nuthatch-org/nuthatch-frontend/blob/main/public/install.sh" rel="noopener">verify the script</a>
        </p>
      </div>

      <div class="hero-links rise rise-3">
        <a class="btn btn-primary" href="/install">Read the install guide</a>
        <a class="btn btn-ghost" href={GH} rel="noopener">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          Star on GitHub
          <span class="stars"><!-- TODO: live badge post-launch -->-</span>
        </a>
      </div>
      </div>

      <!-- The instrument: on wide screens a CRT replays the transcript below it, which stays in the
           page for readers without WebGL, for phones and for crawlers. -->
      <figure class="hero-instrument rise rise-2">
        <div class="hero-well" data-crt={crt}>
          <p class="fd-instrument-plate hero-plate" aria-hidden="true">Real run <b>init, then dev</b></p>
          <div class="hero-crt" aria-hidden="true"></div>
          <Terminal />
        </div>
        <figcaption class="demo-caption">
        A real run of 5.9.0, with the log trimmed to the lines that matter. <code>init</code> resolves the ABI and scaffolds the
        project; <code>dev</code> follows the tip, seals finalized ranges to Parquet, and serves it.
        <code>--backfill 300</code> starts 300 blocks behind the tip, so there are rows within
        seconds; without it <code>dev</code> backfills from deployment, which for a contract with a
        long history wants your own archive-capable RPC.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. PROOF BAND -->
  <section class="proof" aria-label="Measured">
    <div class="wrap">
      <div class="fd-stats">
        <div class="fd-stat">
          <p class="fd-stat-l">Peak memory, measured</p>
          <p class="fd-stat-n">&lt; 1.8 <span class="u">GiB peak</span></p>
          <p class="fd-stat-s">The largest nest we run, answering the 74 statements its dashboard and jobs send, two at a time under its production limits on Linux: 1,595 to 1,788 MiB over four runs of 4.4.0, inside the 2 GB budget. <a href="https://github.com/nuthatch-org/nuthatch/releases/tag/v4.4.0" rel="noopener">Release notes</a>.</p>
        </div>
        <div class="fd-stat">
          <p class="fd-stat-l">OBIB case 6, measured</p>
          <p class="fd-stat-n">4.67 <span class="u">s</span></p>
          <p class="fd-stat-s">Sentio's <a href="https://github.com/sentioxyz/open-blockchain-indexer-benchmark" rel="noopener">OBIB</a> case 6, the Uniswap V2 factory over 10,001 blocks with 232 pairs discovered as it ran: 35,271 events in 14 RPC requests and 229 MB, median of five runs of the published 4.7.0 binary against a keyless public gateway. Someone else's benchmark, not a ranking. <a href="https://github.com/nuthatch-org/nuthatch/blob/main/docs/bench/obib-case6-4.7.0-tenderly-2026-10-05.md" rel="noopener">The run's record</a>.</p>
        </div>
        <div class="fd-stat">
          <p class="fd-stat-l">Address to API, measured</p>
          <p class="fd-stat-n">10 to 11 <span class="u">s</span></p>
          <p class="fd-stat-s">Contract address to a live indexed API: the README quickstart run as written in a clean <code>ubuntu:24.04</code> container. <a href="https://github.com/nuthatch-org/nuthatch/releases/tag/v4.8.0" rel="noopener">4.8.0 release notes</a>.</p>
        </div>
        <div class="fd-stat">
          <p class="fd-stat-l">Phone-home</p>
          <p class="fd-stat-n">Opt-in only</p>
          <p class="fd-stat-s">No gateway, no tokens, no account. The one thing it can send is a <a href="/count">head count</a>, and only after you say yes. It reads from an RPC endpoint you choose, which can be your own node.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. HOW IT WORKS -->
  <section class="how" id="how">
    <div class="wrap">
      <p class="section-label">How it works</p>
      <h2 class="how-h narrow">One process, from RPC to a query you can trust.</h2>
      <div class="how-diagram">
        <PipelineScene />
      </div>
      <div class="how-cols">
        <div>
          <h3>Two engines, one binary</h3>
          <p>
            A hot store (redb) answers entity point-reads at the tip. Past finality, ranges
            seal to content-addressed Parquet segments, and Burrmill, an embedded query engine on
            DataFusion, reads them for analytical SQL. Single writer, no Postgres, no Docker.
          </p>
        </div>
        <div>
          <h3>Entities maintained as blocks arrive</h3>
          <p>
            General authored views run when queried. For a repeated, expensive aggregate, declare
            an entity in <code>entities.toml</code> and Nuthatch maintains the keyed relation as
            blocks arrive. A reorg is a retraction, not a pile of rollback code.
          </p>
        </div>
        <div>
          <h3>Deterministic by construction</h3>
          <p>
            Decode and derivation are reproducible: the same blocks in always give the same
            rows and entities out, so anyone can re-execute a nest and check the answer. Effects
            such as webhooks and alerts happen after sealing, never in the data path.
          </p>
        </div>
      </div>
      <p class="how-foot">
        Where this is going is public, RFC by RFC - <a href="/roadmap">see the roadmap</a>.
      </p>
    </div>
  </section>

  <hr class="divider" />

  <!-- 4b. THREE FRONT DOORS -->
  <section class="doors">
    <div class="wrap">
      <p class="section-label">Who runs it</p>
      <h2 class="narrow doors-h">Three front doors.</h2>
      <div class="doors-grid">
        <div class="door">
          <span class="door-k">App backends</span>
          <p>GET /sql, like a database that fills itself.</p>
        </div>
        <div class="door">
          <span class="door-k">Analysts</span>
          <p>run a published nest, write no indexing code.</p>
        </div>
        <div class="door">
          <span class="door-k">Agents</span>
          <p>built-in MCP, fully local.</p>
        </div>
      </div>
      <p class="doors-link"><a href="/stories">Who runs Nuthatch →</a></p>
    </div>
  </section>

  <hr class="divider" />

  <!-- 5. COMPARISON -->
  <section class="compare" id="compare">
    <div class="wrap">
      <p class="section-label">Where it sits</p>
      <h2 class="narrow">The honest comparison.</h2>
      <div class="table-scroll">
        <table class="ctable">
          <thead>
            <tr>
              <th scope="col" class="ct-feature"></th>
              {cols.map((c) => <th scope="col">{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <th scope="row" class={r.us ? 'ct-feature ct-us' : 'ct-feature'}>{r.p}</th>
                {r.c.map((cell) => <td class={r.us ? 'ct-us' : ''}><span class="ct-text">{cell}</span></td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="compare-foot">
        Like Ponder, Nuthatch reads the chain over JSON-RPC, so it needs an endpoint, and a provider may
        charge for one. The public endpoints it bundles are for trying it out, not for keeping it running.
        It complements The Graph rather than replacing it: a subgraph serves an application from a network
        of indexers, while a nest puts a contract's history in a database on your own machine.
      </p>
    </div>
  </section>

  <hr class="divider" />

  <!-- 5b. REAL EXAMPLE TEASER -->
  <section class="teaser" id="example">
    <div class="wrap">
      <div class="teaser-inner">
        <div>
          <p class="section-label">Worked example</p>
          <h2 class="teaser-h">From contract to nest.</h2>
          <p class="teaser-copy">
            USDC on Ethereum mainnet, indexed from its contract address: raw event tables queryable
            over read-only SQL, then an authored view or a maintained entity on top. It runs today.
            GraphQL for subgraph-shaped clients shipped in 3.7.0 only as a partial read surface, is
            parked, and is served only by the separate <code>nuthatch-graph</code> download attached
            to every release since 4.11.0.
          </p>
        </div>
        <a class="btn btn-ghost teaser-btn" href="/example">See the example →</a>
      </div>
    </div>
  </section>

  <hr class="divider" />

  <!-- 6. AI-NATIVE -->
  <section class="ai" id="ai">
    <div class="wrap">
      <p class="section-label">AI-native, sovereignty-respecting</p>
      <h2 class="narrow">The AI writes the code. It never sits in the data path.</h2>
      <div class="ai-cols">
        <div class="card ai-card">
          <span class="ai-kicker">For agents</span>
          <ul class="ai-list">
            <li>A built-in MCP server: eight tools on every nest, covering schema discovery, SQL, entity lookup and <code>diff</code>, plus <code>balance</code> and <code>top_balances</code> on a token nest; three resources and two prompts. Flags, exposure and a third prompt appear when the compliance pack is configured.</li>
            <li>A governed semantic layer: <code>schema</code> serves <em>this</em> nest's meaning, and a failed query comes back as a fix hint (<code>explain</code> checks a query before it runs) - so the agent gets it right first try.</li>
            <li>Ships <code>llms.txt</code> and a Claude Code skill an agent uses to <em>drive</em> nuthatch, not just read it.</li>
            <li>Works fully offline against your local instance.</li>
          </ul>
        </div>
        <div class="card ai-card">
          <span class="ai-kicker">For you</span>
          <ul class="ai-list">
            <li><code>init</code> resolves the ABI and scaffolds the project: config, <code>llms.txt</code>, and a Claude Code skill.</li>
            <li>The skill hands the tool the real query surface, so it uses actual endpoints, not guesses.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="close">
    <div class="wrap narrow close-inner">
      <p class="section-label">Install</p>
      <h2>Under two minutes. One binary. No one to ask.</h2>
      <CopyBlock command="curl -fsSL https://nuthatch-indexer.com/install.sh | sh" size="lg" />
      <p class="close-alt"><a href="/install">Full install options</a> · <a href="/manifesto">Read the manifesto</a></p>
    </div>
  </section>
</Layout>

<style>
  /* HERO: one claim and one instrument */
  .hero { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-12); align-items: center; }
  @media (min-width: 1080px) { .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); } }
  .hero-eyebrow { margin-bottom: 1.2rem; }
  .hero h1 { max-width: 16ch; font-size: clamp(2.4rem, 5vw, 4.4rem); line-height: 1.03; letter-spacing: -0.04em; }
  .hero-sub { margin-top: 1.4rem; font-size: 1rem; line-height: 1.6; max-width: 60ch; color: var(--text-muted); }
  .hero-cta { margin-top: 2rem; max-width: 40rem; }
  .hero-alt { margin-top: 0.8rem; font-size: 0.75rem; color: var(--text-muted); }
  .hero-alt code { font-size: 0.82em; }
  .hero-links { margin-top: 1.6rem; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; }
  .stars { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--text-faint); margin-left: 0.15rem; }

  .hero-instrument { margin: 0; min-width: 0; }
  .hero-well { position: relative; }
  .hero-plate, .hero-crt { display: none; }
  .demo-caption { margin-top: 1rem; font-size: 0.75rem; line-height: 1.6; color: var(--text-muted); max-width: 42rem; }
  /* Once the CRT is lit, the well takes the machine and the DOM transcript stays in the page, unseen. */
  @media (min-width: 920px) {
    .hero-well.is-crt {
      background: var(--bg-code); border: 1px solid var(--border); border-radius: var(--radius-md);
      overflow: hidden; aspect-ratio: 8 / 6.4; max-height: 26rem; width: 100%;
    }
    .hero-well.is-crt .hero-plate { display: flex; }
    .hero-well.is-crt .hero-crt { display: block; position: absolute; inset: 0; }
    .hero-well.is-crt :global(.term) {
      position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; border: 0;
      overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
    }
  }
  @media (min-width: 1080px) { .hero-well.is-crt { max-height: 34rem; } }
  .hero-crt :global(.fd-stage-canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

  /* PROOF BAND */
  .proof { padding-block: 0 clamp(3rem, 6vw, 4.5rem); }
  .proof .fd-stat-s a { white-space: nowrap; }
  .demo-caption code { white-space: nowrap; }

  /* HOW */
  .how-h { margin-bottom: 2.2rem; }
  .how-diagram { margin-bottom: 2.8rem; }
  .how-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem 2.5rem; }
  .how-cols h3 { margin-bottom: 0.6rem; }
  .how-cols p { color: var(--text-muted); font-size: 0.875rem; }
  @media (max-width: 46rem) { .how-cols { grid-template-columns: 1fr; gap: 1.8rem; } }
  .how-foot { margin-top: 2.4rem; color: var(--text-muted); font-size: 0.875rem; }

  /* DOORS */
  .doors-h { margin-bottom: 2rem; }
  .doors-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .door { border: 1px solid var(--border); border-radius: var(--radius); padding: 1.2rem 1.3rem; }
  .door-k {
    font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--accent);
  }
  .door p { margin-top: 0.5rem; color: var(--text-muted); font-size: 0.875rem; }
  .doors-link { margin-top: 1.4rem; font-size: 0.8125rem; }
  .doors-link a { font-family: 'JetBrains Mono', monospace; }
  @media (max-width: 44rem) { .doors-grid { grid-template-columns: 1fr; } }

  /* COMPARE */
  .compare h2 { margin-bottom: 2rem; }
  .table-scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); }
  .ctable { width: 100%; border-collapse: collapse; min-width: 48rem; font-size: 0.8125rem; }
  .ctable th, .ctable td { text-align: left; padding: 0.85rem 1rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  .ctable thead th { font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; letter-spacing: 0.02em; color: var(--text-muted); font-weight: 500; }
  .ctable tbody tr:last-child th, .ctable tbody tr:last-child td { border-bottom: 0; }
  .ct-feature { color: var(--text); font-weight: 500; width: 32%; }
  .ct-us { background: var(--pale-blue-bg); }
  thead .ct-us { color: var(--accent-ink); font-weight: 600; }
  .ct-text { color: var(--text); }
  .compare-foot { margin-top: 1.2rem; font-size: 0.75rem; color: var(--text-muted); }

  /* TEASER */
  .teaser-inner {
    display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem;
    background: var(--bg-elev); border: 1px solid var(--border);
    border-radius: var(--radius); padding: clamp(1.6rem, 4vw, 2.6rem);
  }
  .teaser-h { margin-bottom: 0.9rem; max-width: 20ch; }
  .teaser-copy { color: var(--text-muted); font-size: 0.875rem; max-width: 52ch; }
  .teaser-btn { flex-shrink: 0; white-space: nowrap; }
  @media (max-width: 44rem) {
    .teaser-inner { flex-direction: column; align-items: flex-start; }
  }

  /* AI */
  .ai h2 { margin-bottom: 2rem; }
  .ai-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .ai-kicker {
    font-family: 'JetBrains Mono', monospace; font-size: 0.6875rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--accent);
  }
  .ai-list { margin: 1rem 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.7rem; }
  .ai-list li { color: var(--text-muted); font-size: 0.875rem; padding-left: 1.3rem; position: relative; }
  .ai-list li::before { content: '↳'; position: absolute; left: 0; color: var(--accent); font-family: 'JetBrains Mono', monospace; }
  @media (max-width: 44rem) { .ai-cols { grid-template-columns: 1fr; } }

  /* CLOSE */
  .close { padding-block: clamp(3.5rem, 7vw, 5.5rem); }
  .close-inner { text-align: center; }
  .close-inner h2 { margin-bottom: 1.8rem; }
  .close-inner :global(.copyblock) { text-align: left; }
  .close-alt { margin-top: 1rem; font-size: 0.8125rem; color: var(--text-muted); }
</style>

<script>
  // Light the hero CRT only on wide screens with WebGL, and only when the well scrolls into view.
  // three and foundry.js are self-hosted under /foundry/; any failure leaves the DOM transcript.
  const well = document.querySelector<HTMLElement>('.hero-well');
  const screen = well?.querySelector<HTMLElement>('.hero-crt');
  const wide = matchMedia('(min-width: 920px)');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const hasWebGL = () => {
    try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); }
    catch { return false; }
  };
  const load = (src: string) => new Promise<void>((resolve, reject) => {
    const s = document.createElement('script');
    s.src = src; s.async = true; s.onload = () => resolve(); s.onerror = () => reject(new Error(src));
    document.head.appendChild(s);
  });

  async function light() {
    if (!well || !screen) return;
    const lines: { rows: string[]; pause: number }[] = JSON.parse(well.dataset.crt ?? '[]');
    try {
      await load('/foundry/three-0.149.0.min.js');
      await load('/foundry/foundry.js');
    } catch { return; }
    const F = (window as any).Foundry;
    if (!F) return;
    well.classList.add('is-crt');
    const all = lines.flatMap((l) => l.rows);
    if (reduced) { F.CRTTerminal(screen, { title: 'nuthatch · zsh', lines: all }); return; }
    const crt = F.CRTTerminal(screen, { title: 'nuthatch · zsh', lines: [] });
    let i = 0;
    const next = () => {
      if (i >= lines.length) return;
      const l = lines[i++];
      l.rows.forEach((r) => crt.push(r));
      setTimeout(next, l.pause + 260);
    };
    setTimeout(next, 500);
  }

  if (well && wide.matches && hasWebGL()) {
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { io.disconnect(); light(); }
    }, { rootMargin: '200px' });
    io.observe(well);
  }
</script>
