  }

  // ---------- drawing
  let items = [], labels = [], overlay = [];
  const fog = d => clamp((d - cam.dist * .75) / (cam.dist * 1.3), 0, 1) * .5;
  function box(x, y, z, sx, sy, sz, col, o) {
    items.push(Object.assign({ k: 0, x, y, z, sx, sy, sz, col, a: 1, d: depth(x, y, z) }, o));
  }
  function quad(pts, col, o) {
    let cx = 0, cy = 0, cz = 0; pts.forEach(p => { cx += p[0]; cy += p[1]; cz += p[2]; });
    const n = pts.length;
    items.push(Object.assign({ k: 1, pts, col, a: .1, d: depth(cx / n, cy / n, cz / n) }, o));
  }
  function path(ps) { ctx.beginPath(); ctx.moveTo(ps[0][0], ps[0][1]); for (let i = 1; i < ps.length; i++) ctx.lineTo(ps[i][0], ps[i][1]); ctx.closePath(); }
  function drawBox(b) {
    const hx = b.sx / 2, hy = b.sy / 2, hz = b.sz / 2, q = [], f = fog(b.d);
    for (let i = 0; i < 8; i++) q.push(proj(b.x + (i & 1 ? hx : -hx), b.y + (i & 2 ? hy : -hy), b.z + (i & 4 ? hz : -hz)));
    ctx.globalAlpha = b.a; ctx.lineWidth = dpr; ctx.lineJoin = 'round';
    const face = (ix, shade, axis) => {
      const col = mix(mix(b.col, P.shade, shade), P.bg, f);
      path([q[ix[0]], q[ix[1]], q[ix[2]], q[ix[3]]]);
      ctx.fillStyle = css(col); ctx.fill();
      ctx.strokeStyle = css(mix(col, P.ink, P.dark ? .22 : .0), .9); ctx.stroke();
      if (b.stripes && axis) {
        ctx.strokeStyle = css(mix(col, P.shade, .3), .8); ctx.beginPath();
        for (let s = 1; s < 4; s++) {
          const t = s / 4;
          const a = axis === 'x' ? proj(b.x + ix.sx * hx, b.y - hy, b.z - hz + t * b.sz) : proj(b.x - hx + t * b.sx, b.y - hy, b.z + ix.sz * hz);
          const c = axis === 'x' ? proj(b.x + ix.sx * hx, b.y + hy, b.z - hz + t * b.sz) : proj(b.x - hx + t * b.sx, b.y + hy, b.z + ix.sz * hz);
          ctx.moveTo(a[0], a[1]); ctx.lineTo(c[0], c[1]);
