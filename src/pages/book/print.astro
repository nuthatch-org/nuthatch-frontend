---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const chapters = (await getCollection('docs'))
  .filter((doc) => doc.id.startsWith('book/') && doc.id !== 'book')
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const rendered = await Promise.all(chapters.map(async (doc) => ({ doc, Content: (await render(doc)).Content })));
---
<Layout
  path="/book/print/"
  title="Nuthatch: the book - print edition"
  description="A print-ready edition of Nuthatch: the book."
>
  <section class="print-book">
    <div class="print-actions wrap">
      <a href="/docs/book/">Back to the web reader</a>
      <button type="button" data-print-book>Print / save as PDF</button>
    </div>
    <article class="print-page">
      <header class="print-cover">
        <p>Nuthatch</p>
        <h1>The book</h1>
        <span>Version 5.5.0 · October 2026</span>
      </header>
      <nav class="print-toc" aria-label="Contents">
        <h2>Contents</h2>
        <ol>{chapters.map((chapter) => <li>{chapter.data.title}</li>)}</ol>
      </nav>
      {rendered.map(({ doc, Content }) => (
        <section class="print-chapter">
          <p class="print-chapter-number">{doc.data.title}</p>
          <Content />
        </section>
      ))}
    </article>
  </section>
  <script>
    document.querySelector<HTMLButtonElement>('[data-print-book]')?.addEventListener('click', () => window.print());
  </script>
</Layout>

<style>
  .print-actions { display: flex; justify-content: space-between; align-items: center; padding-block: 1.2rem; font-size: 0.9rem; }
  .print-actions a { color: var(--text-muted); }
  .print-actions button { border: 1px solid var(--border); border-radius: 999px; background: var(--bg-elev); color: var(--text); cursor: pointer; padding: 0.5rem 0.9rem; font: inherit; }
  .print-page { width: min(100% - 2rem, 48rem); margin: 3rem auto 7rem; }
  .print-cover { min-height: 26rem; display: flex; flex-direction: column; justify-content: center; border-bottom: 1px solid var(--border); }
  .print-cover p, .print-chapter-number { color: var(--rust); font: 0.75rem/1.4 'JetBrains Mono', monospace; letter-spacing: 0.1em; text-transform: uppercase; }
  .print-cover h1 { margin: 0.8rem 0; color: var(--text); font-size: clamp(3.5rem, 11vw, 7rem); letter-spacing: -0.06em; line-height: 0.9; }
  .print-cover span { color: var(--text-faint); font: 0.8rem 'JetBrains Mono', monospace; }
  .print-toc { padding: 4rem 0; border-bottom: 1px solid var(--border); }
  .print-toc h2, .print-chapter :global(h2) { color: var(--text); letter-spacing: -0.03em; }
  .print-toc ol { padding-left: 1.4rem; color: var(--text-muted); font-family: Georgia, 'Times New Roman', serif; line-height: 1.8; }
  .print-chapter { padding-top: 4rem; break-before: page; }
  .print-chapter :global(h1) { color: var(--text); font-size: 2.8rem; letter-spacing: -0.04em; line-height: 1.05; }
  .print-chapter :global(h2) { margin-top: 3.4rem; font-size: 1.8rem; }
  .print-chapter :global(h3) { color: var(--text); margin-top: 2.1rem; }
  .print-chapter :global(p), .print-chapter :global(li) { color: var(--text-muted); font: 1.12rem/1.75 Georgia, 'Times New Roman', serif; }
  .print-chapter :global(p) { margin-bottom: 1.35rem; }
  .print-chapter :global(a) { color: var(--rust); }
  .print-chapter :global(code) { font-family: 'JetBrains Mono', monospace; font-size: 0.8em; }
  .print-chapter :global(pre) { overflow-x: auto; padding: 1rem; border: 1px solid var(--border); }
  @media print {
    :global(.nav), :global(.foot), :global(.skip), .print-actions { display: none !important; }
    :global(body) { background: white; color: #171614; }
    .print-page { width: auto; margin: 0; }
    .print-cover { min-height: 100vh; break-after: page; }
    .print-toc { break-after: page; }
    .print-chapter :global(h1), .print-chapter :global(h2), .print-chapter :global(h3) { color: #171614; break-after: avoid; }
    .print-chapter :global(p), .print-chapter :global(li) { color: #332f2a; }
    .print-chapter :global(a) { color: #8a4b0a; }
    .print-chapter :global(pre) { white-space: pre-wrap; }
  }
</style>
