---
import Mark from './Mark.astro';

// Top-level links stay flat; the rest fold into two groups. Each group is a CSS-only dropdown on
// desktop (hover or focus-within, zero JavaScript, like the theme toggle) and a labelled section of
// the hamburger list on mobile.
const groups = [
  {
    label: 'Docs',
    links: [
      { href: '/docs', text: 'Documentation' },
      { href: '/example', text: 'Worked example' },
      { href: '/docs/book', text: 'Book' },
    ],
  },
  {
    label: 'Project',
    links: [
      { href: '/stories', text: 'Stories' },
      { href: '/roadmap', text: 'Roadmap' },
      { href: '/manifesto', text: 'Manifesto' },
      { href: '/the-graph', text: 'Nuthatch & The Graph' },
      { href: '/subgraphs', text: 'Hosting' },
      { href: '/rotki', text: 'rotki' },
    ],
  },
];
---
<header class="nav">
  <div class="wrap nav-inner">
    <a href="/" class="brand" aria-label="Nuthatch home">
      <Mark size={26} />
      <span>nuthatch</span>
    </a>

    <!-- CSS-only menu toggle: a :has() checkbox hack, zero JavaScript (matches the theme toggle). -->
    <input type="checkbox" id="nav-toggle" class="nav-input" aria-label="Toggle menu" />
    <label for="nav-toggle" class="nav-burger" title="Menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav-links" aria-label="Primary">
      <a href="/install">Install</a>
      {groups.map((group, i) => (
        <>
        <div class="nav-group">
          <button type="button" class="nav-group-btn" aria-haspopup="true" aria-controls={`nav-menu-${i}`}>
            {group.label}
            <svg class="nav-chevron" viewBox="0 0 10 10" aria-hidden="true">
              <path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div class="nav-menu" id={`nav-menu-${i}`}>
            {group.links.map((link) => <a href={link.href}>{link.text}</a>)}
          </div>
        </div>
        {/* Nests, Mirror and Blog sit between the two groups, so the flat links alternate with the folded ones. */}
        {i === 0 && <a href="/nests">Nests</a>}
        {i === 0 && <a href="/mirror">Mirror</a>}
        {i === 0 && <a href="/blog">Blog</a>}
        </>
      ))}
      <a href="https://github.com/nuthatch-org/nuthatch" rel="noopener">GitHub</a>
      <a href="/play/" class="nav-play" title="Run SQL over a live nest, in this tab">
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.8v8.4L10 6z" fill="currentColor" /></svg>
        Play
      </a>
      <!-- CSS-only theme toggle: a :has() checkbox hack, zero JavaScript. -->
      <input type="checkbox" id="theme-toggle" class="theme-input" aria-label="Switch to light theme" />
      <label for="theme-toggle" class="theme-toggle" title="Toggle light / dark">
        <span class="theme-dot" aria-hidden="true"></span>
        <span class="theme-word theme-word--dark">dark</span>
        <span class="theme-word theme-word--light">light</span>
      </label>
    </nav>

    <!-- Opens the command palette (Palette.astro), which also answers Cmd+K and "/". Hidden until
         that script runs, since without it the button would do nothing. -->
    <button type="button" class="nav-search" data-palette-open aria-label="Search" aria-haspopup="dialog" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 4 4" />
      </svg>
      <span class="nav-search-label" aria-hidden="true">Search</span>
      <kbd aria-hidden="true"></kbd>
    </button>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    position: relative;
    display: flex; align-items: center; justify-content: space-between;
    height: 58px;
  }
  .brand {
    display: inline-flex; align-items: center; gap: 0.5rem;
    color: var(--text); font-weight: 600; letter-spacing: -0.02em; font-size: 1.02rem;
    margin-right: auto;
  }
  .brand:hover { text-decoration: none; }
  .nav-links { display: flex; align-items: center; gap: clamp(0.9rem, 2.4vw, 1.6rem); }

  .nav-search {
    display: inline-flex; align-items: center; gap: 0.45rem; flex-shrink: 0;
    margin-left: clamp(0.9rem, 2.4vw, 1.6rem); padding: 0.28rem 0.45rem 0.28rem 0.6rem;
    font: inherit; font-size: 0.82rem; color: var(--text-muted); cursor: pointer;
    background: none; border: 1px solid var(--border); border-radius: var(--radius-sm);
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease);
  }
  .nav-search[hidden] { display: none; }
  .nav-search:hover { color: var(--text); border-color: var(--border-hi); }
  .nav-search svg { width: 15px; height: 15px; }
  .nav-search kbd { font-size: 0.66rem; border-bottom-width: 1px; }
  /* Between the phone menu and a roomy header there is space for the icon and nothing else. */
  @media (max-width: 64rem) {
    .nav-search { padding: 0.4rem; }
    .nav-search-label, .nav-search kbd { display: none; }
  }
  .nav-links a { color: var(--text-muted); font-size: 0.92rem; }
  .nav-links a:hover { color: var(--text); text-decoration: none; }

  /* The one filled control in the header. A deeper terracotta than --rust, which white text cannot
     read on at AA; the glow is the only motion and stops for reduced-motion. */
  .nav-links a.nav-play {
    --play: #b4542a;
    display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem; border-radius: 999px;
    background: var(--play); color: #fff; font-weight: 600; letter-spacing: 0.01em;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--play) 55%, transparent);
    animation: play-glow 2.8s var(--ease) infinite;
    transition: transform 0.18s var(--ease), background 0.18s var(--ease);
  }
  :root[data-theme=light] .nav-links a.nav-play { --play: #a8481f; }
  .nav-links a.nav-play:hover { color: #fff; background: color-mix(in srgb, var(--play) 85%, #000); transform: translateY(-1px); }
  .nav-play svg { width: 11px; height: 11px; }
  @keyframes play-glow {
    0%, 55% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--play) 55%, transparent); }
    100% { box-shadow: 0 0 0 9px color-mix(in srgb, var(--play) 0%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) { .nav-links a.nav-play { animation: none; } }

  /* Dropdown groups. The trigger is a real button so it takes keyboard focus; the menu opens on
     hover or on focus anywhere inside the group, and closes when both leave. */
  .nav-group { position: relative; }
  .nav-group-btn {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font: inherit; font-size: 0.92rem; color: var(--text-muted);
    background: none; border: 0; padding: 0; cursor: pointer;
  }
  .nav-chevron { width: 10px; height: 10px; transition: transform 0.18s var(--ease); }
  .nav-group:hover .nav-group-btn, .nav-group:focus-within .nav-group-btn { color: var(--text); }
  .nav-group:hover .nav-chevron, .nav-group:focus-within .nav-chevron { transform: translateY(1px); }
  .nav-menu {
    display: none; flex-direction: column; gap: 0.1rem;
    position: absolute; top: calc(100% + 0.55rem); left: -0.5rem; min-width: 12.5rem;
    background: var(--bg-elev); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 0.4rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  }
  /* Invisible bridge over the gap between trigger and menu, so the pointer can cross it. */
  .nav-menu::before { content: ''; position: absolute; left: 0; right: 0; top: -0.65rem; height: 0.65rem; }
  .nav-group:hover .nav-menu, .nav-group:focus-within .nav-menu { display: flex; }
  .nav-menu a { padding: 0.5rem 0.7rem; border-radius: var(--radius-sm); white-space: nowrap; }
  .nav-menu a:hover, .nav-menu a:focus-visible { background: var(--bg-inset); color: var(--text); }

  /* Hamburger - hidden on desktop, a CSS-only toggle on mobile. */
  .nav-input { position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0; }
  .nav-burger {
    display: none; flex-direction: column; gap: 4px; cursor: pointer;
    padding: 9px 8px; margin: -9px -8px; border-radius: 8px;
  }
  .nav-burger span {
    display: block; width: 20px; height: 2px; border-radius: 2px;
    background: var(--text-muted); transition: transform 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .nav-burger:hover span { background: var(--text); }
  .nav-input:focus-visible + .nav-burger { outline: 2px solid var(--accent); outline-offset: 3px; }

  .theme-input { position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0; }
  .theme-toggle {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: 'JetBrains Mono', monospace; font-size: 0.72rem;
    color: var(--text-muted); cursor: pointer; user-select: none;
    border: 1px solid var(--border); border-radius: 9999px;
    padding: 0.22rem 0.6rem 0.22rem 0.5rem;
    transition: border-color 0.18s var(--ease), color 0.18s var(--ease);
  }
  .theme-toggle:hover { color: var(--text); border-color: var(--border-hi); }
  .theme-input:focus-visible + .theme-toggle { outline: 2px solid var(--accent); outline-offset: 2px; }
  .theme-dot {
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--rust); box-shadow: inset 0 0 0 3px var(--bg);
    transition: background 0.2s var(--ease);
  }
  :root[data-theme='light'] .theme-dot { background: var(--warn); }
  .theme-word--light { display: none; }
  :root[data-theme='light'] .theme-word--dark { display: none; }
  :root[data-theme='light'] .theme-word--light { display: inline; }

  /* Mobile: collapse the links into a dropdown behind the hamburger. Groups flatten into labelled
     sections of the same list, so nothing needs a second tap to reach. */
  @media (max-width: 48rem) {
    .nav-burger { display: inline-flex; order: 2; margin-left: 0.5rem; }
    .nav-search { order: 1; margin-left: auto; padding: 0.5rem; }
    .nav-links {
      display: none;
      position: absolute; top: 58px; left: 0; right: 0;
      flex-direction: column; align-items: stretch; gap: 0;
      background: var(--bg-elev); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 0.4rem;
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
    }
    :root:has(#nav-toggle:checked) .nav-links { display: flex; }
    .nav-links a { padding: 0.7rem 0.8rem; border-radius: var(--radius-sm); font-size: 0.98rem; }
    .nav-links a:hover { background: var(--bg-inset); }
    .nav-group { display: flex; flex-direction: column; }
    .nav-group-btn {
      pointer-events: none; padding: 0.8rem 0.8rem 0.3rem;
      font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--text-faint);
    }
    .nav-chevron { display: none; }
    .nav-menu {
      display: flex; position: static; min-width: 0; gap: 0;
      background: none; border: 0; border-radius: 0; padding: 0; box-shadow: none;
    }
    .nav-menu::before { display: none; }
    .nav-menu a { padding: 0.6rem 0.8rem 0.6rem 1.4rem; white-space: normal; }
    .theme-toggle { align-self: flex-start; margin: 0.6rem 0.8rem 0.2rem; }
    /* Burger → X when open. */
    :root:has(#nav-toggle:checked) .nav-burger span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
    :root:has(#nav-toggle:checked) .nav-burger span:nth-child(2) { opacity: 0; }
    :root:has(#nav-toggle:checked) .nav-burger span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  }
</style>
