---
import Layout from '../layouts/Layout.astro';
import CodeCard from '../components/CodeCard.astro';

const endpoint = 'https://count.nuthatch-indexer.com';
const counted = '{"v":1,"event":"counted","version":"5.9.0","os":"linux","arch":"x86_64"}';
const payload = '{"v":1,"event":"init","version":"5.9.0","os":"linux","arch":"x86_64","chain":42161,"source":"addresses"}';
const receiver = 'https://github.com/nuthatch-org/nuthatch/tree/main/count/receiver';
---

<Layout
  path="/count"
  title="The head count - Nuthatch"
  description="How many people have said yes to being counted, and how many nests they have created. Floors, not counts, published as they arrive."
>
  <section class="page">
    <div class="wrap narrow">
      <p class="section-label">Head count</p>
      <h1>How many people use Nuthatch</h1>
      <p class="lede">
        After your first <code>nuthatch init</code>, Nuthatch asks once whether it may count you. The
        default is no. These are the totals from everyone who said yes. Most people say no or are never
        asked, so every number here is a floor.
      </p>

      <div class="totals" id="totals" aria-live="polite">
        <div><span class="cap">said yes</span><span class="big" data-key="counted">-</span></div>
        <div><span class="cap">nests created</span><span class="big" data-key="init">-</span></div>
      </div>
      <p class="since" id="since">Reading the counter...</p>
      <noscript><p class="since">This page reads the totals from {endpoint}/totals in your browser.</p></noscript>

      <div class="breakdowns" id="breakdowns" hidden>
        <section><h2>By chain</h2><dl data-prefix="init.chain."></dl></section>
        <section><h2>By kind of init</h2><dl data-prefix="init.source."></dl></section>
        <section><h2>By version</h2><dl data-prefix="init.version."></dl></section>
        <section><h2>By platform</h2><dl data-prefix="init.os_arch."></dl></section>
      </div>

      <section class="notes">
        <h2>What is sent</h2>
        <p>
          Saying yes sends one <code>counted</code> object to {endpoint}, so the page can tell people
          from nests. After a yes at <code>init</code> it also carries that nest's chain and kind of
          <code>init</code>; <code>nuthatch count on</code> sends it with neither.
        </p>
        <CodeCard code={counted} lang="json" label="counted" />
        <p>
          With a yes, each <code>init</code> then sends one object like this. It carries the
          version, the platform, a chain id from the built-in list (anything else is sent as 0) and which
          kind of <code>init</code> it was. There is no identifier and no address.
          <code>nuthatch count payload</code> prints both of yours.
        </p>
        <CodeCard code={payload} lang="json" label="init" />
        <h2>What is kept</h2>
        <p>
          A tally per day for each of those values, and nothing else: no IP address, no header, no copy of
          the request. The <a href={receiver} rel="noopener">receiver's source</a> is short enough to check
          that in a few minutes. Anyone can send a ping, so the totals can only be read as floors.
        </p>
        <h2>Changing your mind</h2>
        <p>
          <code>nuthatch count off</code> stops it, <code>nuthatch count on</code> says yes,
          <code>nuthatch count forget</code> makes the next <code>init</code> ask again, and
          <code>nuthatch count</code> shows where things stand. Setting <code>NUTHATCH_NO_COUNT</code> or <code>CI</code> silences it on that machine.
        </p>
      </section>
    </div>
  </section>
</Layout>

<script>
  const endpoint = 'https://count.nuthatch-indexer.com/totals';
  const chains: Record<string, string> = {
    '0': 'other', '1': 'Ethereum', '42161': 'Arbitrum One', '8453': 'Base', '56': 'BNB Chain',
    '137': 'Polygon', '100': 'Gnosis', '10': 'Optimism', '143': 'Monad', '4663': 'Robinhood Chain',
  };
  const fmt = (n: number) => n.toLocaleString('en-GB');

  async function load() {
    const since = document.getElementById('since')!;
    let days: Record<string, Record<string, number>>;
    try {
      const res = await fetch(endpoint, { cache: 'no-store' });
      if (!res.ok) throw new Error(String(res.status));
      days = await res.json();
    } catch {
      since.textContent = 'The counter could not be reached just now.';
      return;
    }
    const sum: Record<string, number> = {};
    for (const tallies of Object.values(days)) {
      for (const [k, n] of Object.entries(tallies)) sum[k] = (sum[k] ?? 0) + n;
    }
    for (const el of document.querySelectorAll<HTMLElement>('[data-key]')) {
      el.textContent = fmt(sum[el.dataset.key!] ?? 0);
    }
    const first = Object.keys(days).sort()[0];
    since.textContent = first ? `Since ${first}, in UTC days.` : 'Nobody has been counted yet.';
    for (const dl of document.querySelectorAll<HTMLElement>('dl[data-prefix]')) {
      const prefix = dl.dataset.prefix!;
      const rows = Object.entries(sum)
        .filter(([k]) => k.startsWith(prefix))
        .map(([k, n]) => [k.slice(prefix.length), n] as const)
        .sort((a, b) => b[1] - a[1]);
      for (const [name, n] of rows) {
        const row = document.createElement('div');
        const dt = document.createElement('dt');
        const dd = document.createElement('dd');
        dt.textContent = prefix === 'init.chain.' ? (chains[name] ?? `chain ${name}`) : name;
        dd.textContent = fmt(n);
        row.append(dt, dd);
        dl.append(row);
      }
    }
    if (first) document.getElementById('breakdowns')!.hidden = false;
  }
  load();
</script>

<style>
  .page { padding-block: clamp(3rem, 6vw, 4.5rem) clamp(4rem, 9vw, 6.5rem); }
  h1 { margin-bottom: 0.8rem; }
  .lede { color: var(--text-muted); font-size: 1.08rem; line-height: 1.7; margin-bottom: 2rem; max-width: 62ch; }
  code {
    background: var(--bg-inset); border: 1px solid var(--border);
    border-radius: var(--radius-sm); padding: 0.05rem 0.35rem; font-size: 0.85em;
  }
  .totals { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: 1rem; }
  .totals > div {
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--bg-elev); padding: 1.2rem 1.3rem;
  }
  .cap {
    display: block; font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--text-faint); margin-bottom: 0.4rem;
  }
  .big { font-family: 'JetBrains Mono', monospace; font-size: clamp(2rem, 6vw, 2.8rem); color: var(--text); }
  .since { color: var(--text-faint); font-size: 0.88rem; margin: 0.8rem 0 2.5rem; }
  .breakdowns { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.5rem; margin-bottom: 3rem; }
  .breakdowns[hidden] { display: none; }
  .breakdowns h2, .notes h2 { font-size: clamp(1.05rem, 2vw, 1.25rem); margin: 0 0 0.6rem; }
  .breakdowns dl { margin: 0; display: grid; gap: 0.3rem; }
  .breakdowns dl div { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.86rem; border-bottom: 1px solid var(--border); padding-bottom: 0.25rem; }
  .breakdowns dt { color: var(--text-muted); overflow-wrap: anywhere; }
  .breakdowns dd { margin: 0; font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: var(--text); }
  .notes h2 { margin-top: 2rem; }
  .notes p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.65; margin: 0 0 1rem; max-width: 72ch; }
</style>
