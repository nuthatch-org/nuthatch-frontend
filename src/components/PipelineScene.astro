    flat(5.55, 9.75, -2.55, 2.55, mix(P.surface, P.slate, .2), 1);       // segment shelf
    line3([GATE_X, .02, 0], [HEAD_X + .5, .02, 0], P.muted, .4, 1);
  }

  function build() {
    const wide = cssW >= 640, v = view;
    // 1 chain
    const neutral = mix(P.muted, P.bg, .35);
    const live = S.chain.filter(c => !c.dead);
    S.chain.forEach((c, i) => {
      const head = c === live[live.length - 1] && !c.fade;
      if (c.dead) { const p = c.dead; box(c.x, .95 - p * .55, p * 2.4, 1, 1, 1, P.rust, { a: 1 - p }); return; }
      const s = .4 + .6 * sm(c.a);
      box(c.x, .95 + (1 - sm(c.a)) * .9, 0, s, s, s, head ? P.buff : neutral, { a: c.a, glow: head ? .55 : 0 });
      const nx = S.chain[i + 1];
      if (nx && !nx.dead && nx.a > .6 && nx.x - c.x > 1.05) box((c.x + nx.x) / 2, .95, 0, nx.x - c.x - 1, .1, .1, neutral, { a: Math.min(c.a, nx.a) });
      if (v === 1) lab(c.x, 1.6, 0, (head ? '#' + fmt(c.b.no) : '…' + String(c.b.no).slice(-3)) + (c.b.alt ? '′' : ''), { c: head ? 'buff' : 'muted', a: c.a });
    });
    // 2 decode gate
    const gcol = mix(P.muted, P.ink, .25);
    box(GATE_X, 1.1, -1.25, .22, 2.2, .22, gcol); box(GATE_X, 1.1, 1.25, .22, 2.2, .22, gcol); box(GATE_X, 2.31, 0, .22, .22, 2.72, gcol);
