  function lab(x, y, z, text, o) { labels.push(Object.assign({ x, y, z, text }, o)); }

  function ground() {
    for (let x = -22; x <= 20; x += 2) { const e = sm(Math.min(x + 22, 20 - x) / 8); if (e > 0) line3([x, 0, -9], [x, 0, 9], P.line, .7 * e, 1, true); }
    for (let z = -8; z <= 8; z += 2) line3([-23, 0, z], [21, 0, z], P.line, .7 * Math.pow(1 - Math.abs(z) / 9.5, 1.4), 1, true);
    flat(-18.2, -9.9, -.62, .62, P.surface, .9);                         // chain rail
    flat(-7, -.9, -4.3, 2.5, P.surface, .8);                             // view circuit board
    for (let l = 0; l < 3; l++) {
      flat(-6.5, -1.3, LANE_Z[l] - .3, LANE_Z[l] + .3, mix(P.surface, P.ink, .1), 1, .02);
      line3([OPX[l], .03, LANE_Z[l]], [OPX[l], .03, BAR_Z], S.barFlash[l] < -.05 ? P.rust : P.lane[l], .28 + Math.abs(S.barFlash[l]) * .6, 1);
      const f = [[OPX[l], .04, LANE_Z[l] - .46], [OPX[l], .86, LANE_Z[l] - .46], [OPX[l], .86, LANE_Z[l] + .46], [OPX[l], .04, LANE_Z[l] + .46]].map(p => proj(p[0], p[1], p[2]));
