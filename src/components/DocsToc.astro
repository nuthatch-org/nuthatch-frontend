---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

const { headings = [] } = Astro.props as { headings?: Heading[] };
const visible = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
{visible.length > 0 && (
  <aside class="docs-toc" aria-label="On this page">
    <p>On this page</p>
    <ol>
      {visible.map((heading) => (
        <li class:list={{ child: heading.depth === 3 }}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </aside>
)}

<style>
  .docs-toc { position: sticky; top: 74px; align-self: start; max-height: calc(100vh - 90px); overflow-y: auto; padding-left: 1rem; border-left: 1px solid var(--border); }
  p { margin: 0 0 0.8rem; font-family: 'JetBrains Mono', monospace; font-size: 0.625rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  ol { list-style: none; margin: 0; padding: 0; }
  li { margin: 0 0 0.45rem; font-size: 0.6875rem; line-height: 1.35; }
  li.child { padding-left: 0.65rem; }
  a { color: var(--text-muted); text-decoration: none; }
  a:hover { color: var(--text); }
  @media (max-width: 72rem) { .docs-toc { display: none; } }
</style>
