---
// The data path as a live 3D scene: hand-rolled projection on a 2D canvas, no dependencies.
// The rail under it carries the same five stages as text, so nothing is lost without JS.
---
<div class="ps" id="ps">
  <p class="ps-lede">Drag to look around, or pick a stage. The blocks are simulated. The path they take is the real one.</p>

  <div class="ps-stage">
    <canvas id="ps-canvas" tabindex="0" role="img"
      aria-label="Animated 3D diagram of the Nuthatch pipeline. Blocks arrive from chain RPC, logs are decoded by topic0, incremental views update, rows land in the redb hot store, blocks past finality seal into Parquet segments, and Burrmill answers queries over both from one local endpoint."></canvas>
  </div>

  <div class="ps-bar">
    <dl class="ps-read">
      <div><dt>tip</dt><dd id="ps-tip">#21,403,118</dd></div>
      <div><dt>unsealed</dt><dd id="ps-hot">5 blocks</dd></div>
      <div><dt>sealed</dt><dd id="ps-cold">9 segments</dd></div>
    </dl>
    <div class="ps-ctl">
      <button class="ps-btn" type="button" id="ps-all" aria-pressed="true">Whole pipeline</button>
      <button class="ps-btn ps-btn--reorg" type="button" id="ps-reorg">Trigger a reorg</button>
      <button class="ps-btn" type="button" id="ps-play">Pause</button>
    </div>
    <p class="ps-status" id="ps-status" aria-live="polite">following the tip</p>
  </div>

  <ol class="ps-rail" id="ps-rail">
    <li><button type="button" data-view="1" aria-pressed="false"><span class="n">1</span><span class="t">chain RPC</span><span class="d">Blocks arrive from your JSON-RPC endpoints, pooled, with failover and retries.</span></button></li>
    <li><button type="button" data-view="2" aria-pressed="false"><span class="n">2</span><span class="t">deterministic decode</span><span class="d">Logs are decoded by topic0 against versioned ABIs. Same blocks, same rows.</span></button></li>
    <li><button type="button" data-view="3" aria-pressed="false"><span class="n">3</span><span class="t">incremental views</span><span class="d">Entities update as each block lands. A reorg is a retraction, not rollback code.</span></button></li>
    <li><button type="button" data-view="4" aria-pressed="false"><span class="n">4</span><span class="t">redb + Parquet</span><span class="d">The live tip sits in redb. Past finality, blocks seal into immutable Parquet segments.</span></button></li>
    <li><button type="button" data-view="5" aria-pressed="false"><span class="n">5</span><span class="t">one local endpoint</span><span class="d">Burrmill reads hot and sealed data together. Entities, SQL, balances and MCP, one port.</span></button></li>
  </ol>
  <p class="ps-note">Simulation. Block numbers, row counts and segment ids are made up.</p>
</div>

<style>
  /* The scene reads these as hex, so they stay opaque literals rather than the site's rgba borders. */
  .ps {
    --s-bg: #171614; --s-surface: #211f1c; --s-ink: #ece9e3; --s-muted: #9c978c; --s-line: #36332e;
    --s-shade: #0b0a09; --s-buff: #e2c08e; --s-slate: #8bb8dc; --s-rust: #cd8560;
  }
  :root[data-theme='light'] .ps {
    --s-bg: #fbfbfa; --s-surface: #eeece6; --s-ink: #2f3437; --s-muted: #6e6b64; --s-line: #dcd9d1;
    --s-shade: #2b2721; --s-buff: #b98a45; --s-slate: #1f6c9f; --s-rust: #a85a38;
  }

  .ps-lede { color: var(--text-muted); margin: -1rem 0 0; max-width: 38rem; }
  .ps-stage { position: relative; margin-top: 12px; aspect-ratio: 2.5 / 1; max-width: 100%; }
  .ps-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; touch-action: pan-y; outline: none; }
  .ps-stage canvas:active { cursor: grabbing; }
  .ps-stage canvas:focus-visible { outline: 1px solid var(--text-muted); outline-offset: -1px; }

  .ps-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; padding-block: 14px; font: 12px/1.4 'JetBrains Mono', ui-monospace, monospace; }
  .ps-read { display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 0; min-width: 0; }
  .ps-read div { display: flex; gap: 8px; }
  .ps-read dt { color: var(--text-muted); }
  .ps-read dd { margin: 0; font-variant-numeric: tabular-nums; }
  .ps-status { flex-basis: 100%; order: 3; margin: 0; color: var(--text-muted); min-height: 1.4em; }
  .ps-status[data-kind="reorg"] { color: var(--s-rust); }
  .ps-status[data-kind="seal"] { color: var(--s-slate); }
  .ps-status[data-kind="query"] { color: var(--s-buff); }
  .ps-ctl { display: flex; flex-wrap: wrap; gap: 8px; }
  .ps-btn { font: inherit; color: var(--text); background: transparent; border: 1px solid var(--border-hi); border-radius: var(--radius-sm); padding: 7px 12px; cursor: pointer; }
  .ps-btn:hover { border-color: var(--text-muted); }
  .ps-btn:focus-visible, .ps-rail button:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }
  .ps-btn[disabled] { opacity: .45; cursor: default; }
  .ps-btn--reorg { color: var(--s-rust); }
  .ps-btn[aria-pressed="true"] { border-color: var(--text); }

  .ps-rail { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); }
  .ps-rail li { min-width: 0; }
  .ps-rail button { all: unset; box-sizing: border-box; display: grid; gap: 6px; align-content: start; width: 100%; height: 100%; padding: 14px 18px 6px 0; border-top: 1px solid var(--border-hi); cursor: pointer; color: var(--text-muted); }
  .ps-rail button:hover { border-top-color: var(--text-muted); }
  .ps-rail button[aria-pressed="true"] { border-top-color: var(--text); color: var(--text); }
  .ps-rail .n { font: 12px/1 'JetBrains Mono', ui-monospace, monospace; color: var(--text-faint); }
  .ps-rail .t { font: 500 13px/1.3 'JetBrains Mono', ui-monospace, monospace; color: var(--text); }
  .ps-rail .d { font-size: 13.5px; line-height: 1.5; }
  .ps-note { margin: 22px 0 0; font: 12px/1.5 'JetBrains Mono', ui-monospace, monospace; color: var(--text-faint); }

  @media (max-width: 760px) {
    .ps-stage { aspect-ratio: 1.2 / 1; margin-inline: -8px; }
    .ps-rail { grid-template-columns: 1fr; }
    .ps-rail button { grid-template-columns: 1.4em 1fr; padding: 12px 0; column-gap: 8px; }
    .ps-rail .d { grid-column: 2; }
  }
</style>

<script is:inline>
(() => {
  const cv = document.getElementById('ps-canvas');
  if (!cv || !cv.getContext) return;
  const ctx = cv.getContext('2d');
  const $ = id => document.getElementById(id);
  const host = $('ps');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- helpers
  const lerp = (a, b, t) => a + (b - a) * t;
  const clamp = (v, a, b) => v < a ? a : v > b ? b : v;
  const sm = t => { t = clamp(t, 0, 1); return t * t * (3 - 2 * t); };
  const mix = (a, b, t) => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t];
  const css = (c, a = 1) => 'rgba(' + (c[0] | 0) + ',' + (c[1] | 0) + ',' + (c[2] | 0) + ',' + a + ')';
  let seed = 0x9e3779b9;
  const rnd = () => { seed |= 0; seed = seed + 0x6D2B79F5 | 0; let t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; };
  const fmt = n => n.toLocaleString('en-US');

  // ---------- palette (read from the component's tokens so the scene follows the theme)
  const P = {};
  function readPalette() {
    const cs = getComputedStyle(host);
    for (const k of ['bg', 'surface', 'ink', 'muted', 'line', 'shade', 'buff', 'slate', 'rust']) {
      let s = cs.getPropertyValue('--s-' + k).trim().replace('#', '');
      if (s.length === 3) s = [...s].map(c => c + c).join('');
      const n = parseInt(s, 16);
      P[k] = [n >> 16 & 255, n >> 8 & 255, n & 255];
    }
    P.dark = (P.bg[0] + P.bg[1] + P.bg[2]) / 3 < 128;
    P.lane = [P.ink, mix(P.ink, P.bg, .3), mix(P.ink, P.bg, .52)];
  }

  // ---------- world constants
  const HEAD_X = -10.6, GATE_X = -8.5, LANE_Z = [-1.7, 0, 1.7], OPX = [-5.2, -4, -2.8], BAR_Z = -3.5;
  const HOT_X = 1.7, HOT_BASE = 0.25, SLAB = 0.32, PLANE_X = 4.4;
  const SEG_X = [6.7, 8.6], SEG_Z = [-1.7, 0, 1.7], SEG_BASE = 0.46, SEG_P = 0.82;
  const LENS = [11.5, 2.2, 0], EP = [13.4, 2.45, 0];
  const LANES = ['Transfer', 'Swap', 'Sync'], BARS = ['balances', 'exposure', 'velocity'];
  const QUERIES = ['GET /sql', 'nuthatch mcp', 'GET /derived'];
  const slotPos = i => { const w = i % 6; return [SEG_X[w % 2], SEG_BASE + Math.floor(i / 6) * SEG_P, SEG_Z[Math.floor(w / 2)]]; };

  // ---------- camera
  let W = 0, H = 0, cssW = 0, dpr = 1, focal = 1;
  let C = [0, 0, 0], F = [0, 0, -1], R = [1, 0, 0], U = [0, 1, 0];
  const cam = { tx: 0, ty: 1, tz: 0, yaw: -.34, pitch: .36, dist: 40 };
  let goal = { ...cam }, view = 0, userYaw = 0, userPitch = 0, dragging = false;
  const VIEWS = [
    { box: [-17.2, 14.4, 0, 3.6, -3.3, 2.2], yaw: -.3, pitch: .33, nyaw: -.98, npitch: .4 },
    { box: [-17.4, -9.7, 0, 2.6, -1.6, 1.6], yaw: -.5, pitch: .3 },
    { box: [-11.4, -5.6, 0, 3.1, -2.4, 2.4], yaw: -.62, pitch: .3 },
    { box: [-7.1, -.7, 0, 3.6, -4.3, 2.5], yaw: -.26, pitch: .5 },
    { box: [-.5, 10, 0, 4.4, -3.1, 3.1], yaw: -.42, pitch: .34 },
    { box: [5.4, 16.2, 0, 4.5, -3, 3], yaw: .42, pitch: .3 }
  ];
  function setBasis(c) {
    const cp = Math.cos(c.pitch), sp = Math.sin(c.pitch), sy = Math.sin(c.yaw), cy = Math.cos(c.yaw);
    C = [c.tx + c.dist * cp * sy, c.ty + c.dist * sp, c.tz + c.dist * cp * cy];
    F = [-cp * sy, -sp, -cp * cy]; R = [cy, 0, -sy]; U = [-sy * sp, cp, -cy * sp];
  }
  function proj(x, y, z) {
    const dx = x - C[0], dy = y - C[1], dz = z - C[2];
    const d = Math.max(.4, dx * F[0] + dy * F[1] + dz * F[2]), s = focal / d;
    return [W / 2 + (dx * R[0] + dz * R[2]) * s, H * .56 - (dx * U[0] + dy * U[1] + dz * U[2]) * s, d];
  }
  const depth = (x, y, z) => (x - C[0]) * F[0] + (y - C[1]) * F[1] + (z - C[2]) * F[2];
  function fit(v) {
    const narrow = W / H < 1.6, b = v.box;
    const t = { tx: (b[0] + b[1]) / 2, ty: (b[2] + b[3]) / 2, tz: (b[4] + b[5]) / 2, yaw: narrow && v.nyaw != null ? v.nyaw : v.yaw, pitch: narrow && v.npitch != null ? v.npitch : v.pitch, dist: 0 };
    const mx = W * .03, mt = H * .16, mb = H * .05;
    let lo = 4, hi = 260;
    for (let i = 0; i < 24; i++) {
      t.dist = (lo + hi) / 2; setBasis(t);
      let ok = true;
      for (let k = 0; k < 8 && ok; k++) {
        const p = proj(b[k & 1], b[2 + (k >> 1 & 1)], b[4 + (k >> 2 & 1)]);
        if (p[2] < 2 || p[0] < mx || p[0] > W - mx || p[1] < mt || p[1] > H - mb) ok = false;
      }
      if (ok) hi = t.dist; else lo = t.dist;
    }
    t.dist = hi;
    return t;
  }
  function setView(i, snap) {
    view = i; userYaw = 0; userPitch = 0; goal = fit(VIEWS[i]);
    if (snap) Object.assign(cam, goal);
    $('ps-all').setAttribute('aria-pressed', String(i === 0));
    document.querySelectorAll('#ps-rail button').forEach(b => b.setAttribute('aria-pressed', String(+b.dataset.view === i)));
  }

  // ---------- simulation
  let uid = 0;
  const S = {
    t: 0, tip: 21403118, chain: [], chips: [], retr: [], hot: [], segs: [], dying: [], seals: [], sparks: [], pending: [],
    bars: [8, 6, 9], barShow: [8, 6, 9], barFlash: [0, 0, 0],
    nextBlock: .6, nextQuery: 2.2, nextReorg: 1e9, reorgCool: 0, reorgMsg: 0, query: null, qi: 0, sealed: 9,
    gate: 0, plane: 0, planeRust: 0, lens: 0, ep: 0
  };
  const segId = () => { const h = () => Math.floor(rnd() * 65536).toString(16).padStart(4, '0'); return 'seg ' + h() + '…' + h().slice(2); };
  function pickDelta(lane) {
    const v = S.bars[lane], mag = 1 + (rnd() < .3 ? 1 : 0);
    return (v > 11 ? -1 : v < 4 ? 1 : rnd() < .58 ? 1 : -1) * mag;
  }
  function newBlock(no, alt, settled) {
    const b = { id: ++uid, no, alt, n: 3 + Math.floor(rnd() * 3), landed: 0, applied: [] };
    S.tip = no;
    S.chain.push({ b, x: HEAD_X, a: settled ? 1 : 0, dead: 0, fade: false });
    S.hot.push({ b, y: HOT_BASE + S.hot.length * SLAB + (settled ? 0 : .5), fill: settled ? 1 : 0, retract: 0 });
    for (let k = 0; k < b.n; k++) {
      const lane = Math.floor(rnd() * 3);
      if (settled) { b.landed++; b.applied.push({ lane, delta: 1 }); continue; }
      S.chips.push({ b, lane, delta: 0, t0: S.t + .3 + k * .17, crossed: false, gated: false, kill: false, fade: 1, ox: (rnd() - .5) * 1.6, oz: (rnd() - .5) * 1.6, ty: 1, p: null });
    }
  }
  function chipPos(ch, u) {
    const lz = LANE_Z[ch.lane];
    if (u < .2) return [lerp(HEAD_X, GATE_X, u / .2), 1, 0];
    if (u < .36) { const k = sm((u - .2) / .16); return [lerp(GATE_X, -6.4, (u - .2) / .16), lerp(1, .42, k), lz * k]; }
    if (u < .74) return [lerp(-6.4, -1.4, (u - .36) / .38), .42, lz];
    const k = (u - .74) / .26;
    return [lerp(-1.4, HOT_X + ch.ox, k), lerp(.42, ch.ty, k) + Math.sin(k * Math.PI) * 1.1, lerp(lz, ch.oz, k)];
  }
  function retrPos(r, k) {
    const lz = LANE_Z[r.lane];
    if (k < .42) { const j = k / .42; return [lerp(r.from[0], -1.4, j), lerp(r.from[1], .42, j) + Math.sin(j * Math.PI) * .9, lerp(r.from[2], lz, j)]; }
    return [lerp(-1.4, OPX[r.lane], (k - .42) / .58), .42, lz];
  }
  function reorg() {
    if (S.reorgCool > 0) return false;
    const live = S.chain.filter(c => !c.dead && !c.fade);
    if (live.length < 3 || S.hot.length < 3) return false;
    const orphans = live.slice(-2), ids = new Set(orphans.map(c => c.b.id));
    orphans.forEach(c => { c.dead = 1e-3; });
    S.chips.forEach(ch => { if (ids.has(ch.b.id)) ch.kill = true; });
    let n = 0;
    S.hot.forEach((s, i) => {
      if (!ids.has(s.b.id)) return;
      s.retract = 1e-3;
      s.b.applied.forEach(a => S.retr.push({ lane: a.lane, delta: a.delta, t0: S.t + .15 + (n++) * .11, from: [HOT_X, HOT_BASE + i * SLAB, 0] }));
    });
    S.pending = [{ at: S.t + 1.5, no: orphans[0].b.no }, { at: S.t + 2.5, no: orphans[1].b.no }];
    S.tip = orphans[0].b.no - 1;
    S.nextBlock = S.t + 5; S.nextReorg = S.t + 24 + rnd() * 6;
    S.plane = 2.2; S.planeRust = 1; S.reorgCool = 6.5; S.reorgMsg = 5;
    return true;
  }
  function startQuery() {
    const targets = [{ hot: true }], pool = S.segs.slice();
    for (let k = 0; k < 3 && pool.length; k++) targets.push({ seg: pool.splice(Math.floor(rnd() * pool.length), 1)[0] });
    S.query = { t: 0, targets, label: QUERIES[S.qi++ % QUERIES.length], rows: 12 + Math.floor(rnd() * 480), hit: false, back: false };
  }
  function step(dt) {
    S.t += dt; const t = S.t, k6 = 1 - Math.exp(-dt * 6), k4 = 1 - Math.exp(-dt * 4);
    while (S.pending.length && S.pending[0].at <= t) newBlock(S.pending.shift().no, true);
    if (t >= S.nextBlock && !S.pending.length) { newBlock(S.tip + 1, false); S.nextBlock = t + 2.3 + rnd() * .5; }
    if (t >= S.nextReorg) { if (!reorg()) S.nextReorg = t + 3; }
    if (t >= S.nextQuery && !S.query && S.reorgCool < 2.5) startQuery();
    S.reorgCool = Math.max(0, S.reorgCool - dt); S.reorgMsg = Math.max(0, S.reorgMsg - dt);
    S.plane = Math.max(0, S.plane - dt); if (!S.plane) S.planeRust = 0;
    S.gate *= Math.exp(-dt * 5); S.lens *= Math.exp(-dt * 3); S.ep *= Math.exp(-dt * 2.2);

    // chain
    let live = S.chain.filter(c => !c.dead && !c.fade);
    if (live.length > 6) { live[0].fade = true; live = live.slice(1); }
    for (let i = S.chain.length - 1; i >= 0; i--) {
      const c = S.chain[i];
      if (c.dead) { c.dead += dt / 1.3; if (c.dead >= 1) S.chain.splice(i, 1); continue; }
      const j = live.indexOf(c), tx = c.fade ? HEAD_X - live.length * 1.5 : HEAD_X - (live.length - 1 - j) * 1.5;
      c.x += (tx - c.x) * k4;
      c.a += ((c.fade ? 0 : 1) - c.a) * k6;
      if (c.fade && c.a < .03) S.chain.splice(i, 1);
    }
    // hot slabs
    for (let i = S.hot.length - 1; i >= 0; i--) {
      const s = S.hot[i];
      s.y += (HOT_BASE + i * SLAB - s.y) * k6;
      s.fill += (s.b.landed / s.b.n - s.fill) * k6;
      if (s.retract) { s.retract += dt / 1.1; if (s.retract >= 1) S.hot.splice(i, 1); }
    }
    // chips
    for (let i = S.chips.length - 1; i >= 0; i--) {
      const ch = S.chips[i];
      if (ch.kill) { ch.fade -= dt * 2.2; if (ch.fade <= 0 || !ch.p) S.chips.splice(i, 1); continue; }
      const u = (t - ch.t0) / 3.2; if (u < 0) continue;
      const idx = S.hot.findIndex(s => s.b === ch.b); if (idx < 0) { ch.kill = true; continue; }
      ch.ty = HOT_BASE + idx * SLAB + .22;
      ch.p = chipPos(ch, Math.min(u, 1)); ch.u = u;
      if (!ch.gated && u >= .2) { ch.gated = true; S.gate = 1; }
      if (!ch.crossed && ch.p[0] >= OPX[ch.lane]) {
        ch.crossed = true; ch.delta = pickDelta(ch.lane);
        S.bars[ch.lane] += ch.delta; S.barFlash[ch.lane] = 1; ch.b.applied.push({ lane: ch.lane, delta: ch.delta });
        S.sparks.push({ p: [OPX[ch.lane], .45, LANE_Z[ch.lane]], t: 0, rust: false });
      }
      if (u >= 1) { ch.b.landed++; S.chips.splice(i, 1); }
    }
    // retractions travel back up the lane and undo their delta at the operator
    for (let i = S.retr.length - 1; i >= 0; i--) {
      const r = S.retr[i], k = (t - r.t0) / 1.5;
      if (k < 0) { r.p = null; continue; }
      r.p = retrPos(r, Math.min(k, 1));
      if (k >= 1) { S.bars[r.lane] -= r.delta; S.barFlash[r.lane] = -1; S.sparks.push({ p: [OPX[r.lane], .45, LANE_Z[r.lane]], t: 0, rust: true }); S.retr.splice(i, 1); }
    }
    for (let l = 0; l < 3; l++) { S.barShow[l] += (Math.max(.6, S.bars[l]) - S.barShow[l]) * k6; S.barFlash[l] *= Math.exp(-dt * 2.6); }
    // seal: the three oldest complete blocks leave redb and become one segment
    if (S.hot.length >= 7 && !S.seals.length && S.hot.slice(0, 3).every(s => !s.retract && s.b.landed >= s.b.n)) {
      S.hot.splice(0, 3);
      if (S.segs.length >= 24) { S.dying.push(...S.segs.splice(0, 6).map(g => ({ g, t: 0 }))); }
      S.seals.push({ t: 0, slot: S.segs.length });
    }
    for (let i = S.seals.length - 1; i >= 0; i--) {
      const s = S.seals[i], was = s.t; s.t += dt;
      if (was < .55 && s.t >= .55) S.plane = Math.max(S.plane, .7);
      if (s.t >= 1.6) { const p = slotPos(s.slot); S.segs.push({ id: segId(), y: p[1], glow: .9, born: S.t }); S.sealed++; S.seals.splice(i, 1); }
    }
    S.segs.forEach((g, i) => { g.y += (slotPos(i)[1] - g.y) * k4; g.glow *= Math.exp(-dt * 1.6); });
    for (let i = S.dying.length - 1; i >= 0; i--) { S.dying[i].t += dt / .7; if (S.dying[i].t >= 1) S.dying.splice(i, 1); }
    for (let i = S.sparks.length - 1; i >= 0; i--) { S.sparks[i].t += dt / .5; if (S.sparks[i].t >= 1) S.sparks.splice(i, 1); }
    // query
    const q = S.query;
    if (q) {
      q.t += dt;
      if (!q.hit && q.t >= .65) { q.hit = true; S.lens = 1; q.targets.forEach(g => { if (g.seg) g.seg.glow = 1.4; }); }
      if (!q.back && q.t >= 1.6) { q.back = true; S.ep = 1; }
